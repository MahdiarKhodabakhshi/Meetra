# Environment
ENV=local

# Database
DATABASE_URL=postgresql+psycopg://meetra:meetra@localhost:5432/meetra

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth mode: "jwt" for RS256 from auth-service, "dev" for local dev tokens
AUTH_MODE=jwt

# JWT verification (RS256 public key from auth-service)
# The public key is used to verify tokens issued by auth-service
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem
JWT_ALG=RS256
JWT_ISSUER=meetra-auth
JWT_AUDIENCE=meetra

# Legacy HS256 support (for migration, set to true if using old tokens)
JWT_USE_LEGACY_HS256=false

# Token settings (reference only - tokens are issued by auth-service)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Refresh cookie settings (cookie is set by auth-service)
REFRESH_COOKIE_NAME=meetra_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Dev routes protection
DEV_ROUTES_ENABLED=true
DEV_API_KEY=

# CORS (include gateway URL)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:80

# Security baseline
SECURITY_HEADERS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_EXEMPT_PATHS=/health,/metrics